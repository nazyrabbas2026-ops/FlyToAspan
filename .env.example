# FlyToAspan Production Environment Template
# Copy this file to .env and fill in real values (NEVER commit .env to Git!)

PORT=3000
FLYTOASPAN_ORIGIN=https://flytoaspan.com
FLYTOASPAN_DB=.data/flytoaspan.sqlite
# Peer IP of the ingress only. Leave blank when connecting directly.
FLYTOASPAN_TRUSTED_PROXY_IPS=
# Two different random 32-byte keys. Keep these in the hosting secret store.
FLYTOASPAN_PII_KEY=
FLYTOASPAN_BACKUP_KEY=

# Optional: Resend Transactional Email API (https://resend.com)
# Leave empty during local dev; emails activate automatically once set.
RESEND_API_KEY=

# Public business details. Set all four after the site owner confirms who sells the ticket.
FLYTOASPAN_SELLER_NAME=
FLYTOASPAN_SELLER_ADDRESS=
FLYTOASPAN_SELLER_EMAIL=
FLYTOASPAN_SELLER_PHONE=
MAIL_FROM=FlyToAspan <noreply@flytoaspan.com>

# Optional: Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
